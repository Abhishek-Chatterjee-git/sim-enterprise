# Copy to setup.env (ignored by Git), then edit privately.
# This file is ONLY for running setup scripts locally, not Vercel runtime.
DATABASE_URL=
DATABASE_SCHEMA=sim_enterprise
DATABASE_SSL=true
# Optional trusted project CA certificate; literal \n separators are accepted.
DATABASE_SSL_CA=
# Separate randomly generated, URL-safe role passwords, each 32+ characters.
SIM_APP_DB_PASSWORD=
SIM_AGENT_DB_PASSWORD=
